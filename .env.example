# Copy to .env and adjust. Never commit real secrets.
# For full Docker stack locally, you can also start from .env.docker.example
# For Oracle Cloud, use .env.cloud.example → .env.cloud on the server.

# Application
APP_NAME=SENTINEL X
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Paths (D: drive)
PROJECT_ROOT=D:/CyberSecurity_FYP
DATA_DIR=D:/CyberSecurity_FYP/data
PCAP_DIR=D:/CyberSecurity_FYP/data/pcaps
MODEL_DIR=D:/CyberSecurity_FYP/ml/saved_models
DATASET_DIR=D:/CyberSecurity_FYP/ml/datasets
LOG_DIR=D:/CyberSecurity_FYP/logs
REPORT_DIR=D:/CyberSecurity_FYP/reports
SECRET_STORE_DIR=D:/CyberSecurity_FYP/data/secrets

# Database (Docker Compose default)
DATABASE_URL=postgresql+psycopg://cybersec:cybersec_change_me@127.0.0.1:5432/cybersecurity_fyp
POSTGRES_USER=cybersec
POSTGRES_PASSWORD=cybersec_change_me
POSTGRES_DB=cybersecurity_fyp
POSTGRES_PORT=5432

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
FRONTEND_ORIGIN=http://127.0.0.1:5173

# OpenAI — do NOT put a real key here.
# Configure at runtime via Settings → AI Configuration in the UI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Network / analysis
ZEEK_ENABLED=false
ZEEK_PATH=
WIRESHARK_TSHARK_PATH=
MONITORING_MODE=offline
RESPONSE_MODE=approval_required

# Default admin (changed on first login recommended)
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin123!
BOOTSTRAP_ANALYST_EMAIL=analyst@localhost
BOOTSTRAP_ANALYST_PASSWORD=ChangeMeAnalyst123!
