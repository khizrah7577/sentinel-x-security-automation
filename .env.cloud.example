# Oracle Cloud / production — copy to .env.cloud on the server only.
# Never commit filled values. OpenAI key goes through Settings UI after deploy.

APP_ENV=production
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_48_CHARS

POSTGRES_USER=sentinel
POSTGRES_PASSWORD=REPLACE_STRONG_DB_PASSWORD
POSTGRES_DB=sentinel_x

HTTP_PORT=80
HTTPS_PORT=443

# Public URL of your Always Free instance (IP or domain)
FRONTEND_ORIGIN=http://YOUR_PUBLIC_IP_OR_DOMAIN
CORS_ORIGINS=http://YOUR_PUBLIC_IP_OR_DOMAIN

OPENAI_MODEL=gpt-4o-mini

BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_STRONG_ADMIN_PASSWORD
BOOTSTRAP_ANALYST_EMAIL=analyst@localhost
BOOTSTRAP_ANALYST_PASSWORD=REPLACE_STRONG_ANALYST_PASSWORD

# Optional pre-built multi-arch images (after docker buildx bake/push)
# BACKEND_IMAGE=your-registry/sentinel-x-backend:latest
# FRONTEND_IMAGE=your-registry/sentinel-x-frontend:latest
