# Production-style template — copy to .env only on a secured host.
# Never commit real secrets. Prefer runtime AI key via Settings UI.

APP_NAME=CyberSecurity_FYP
APP_ENV=production
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_48_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=30

PROJECT_ROOT=D:/CyberSecurity_FYP
DATA_DIR=D:/CyberSecurity_FYP/data
PCAP_DIR=D:/CyberSecurity_FYP/data/pcaps
MODEL_DIR=D:/CyberSecurity_FYP/ml/saved_models
DATASET_DIR=D:/CyberSecurity_FYP/ml/datasets
LOG_DIR=D:/CyberSecurity_FYP/logs
REPORT_DIR=D:/CyberSecurity_FYP/reports
SECRET_STORE_DIR=D:/CyberSecurity_FYP/data/secrets

DATABASE_URL=postgresql+psycopg://cybersec:REPLACE_STRONG_DB_PASSWORD@127.0.0.1:5432/cybersecurity_fyp
POSTGRES_USER=cybersec
POSTGRES_PASSWORD=REPLACE_STRONG_DB_PASSWORD
POSTGRES_DB=cybersecurity_fyp
POSTGRES_PORT=5432

VITE_API_BASE_URL=https://your-hostname.example/api/v1
FRONTEND_ORIGIN=https://your-hostname.example

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ZEEK_ENABLED=false
MONITORING_MODE=offline
RESPONSE_MODE=approval_required

BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_STRONG_ADMIN_PASSWORD
BOOTSTRAP_ANALYST_EMAIL=analyst@localhost
BOOTSTRAP_ANALYST_PASSWORD=REPLACE_STRONG_ANALYST_PASSWORD
